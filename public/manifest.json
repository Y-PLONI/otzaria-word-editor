{
  "schemaVersion": 1,
  "id": "com.otzaria_word_editor.superdoc",
  "name": "וורד לאוצריא",
  "version": "6.3.0",
  "description": "עורך מסמכים בסגנון Word על מנוע SuperDoc, לכתיבת חידושי תורה בתוך אוצריא",
  "author": "ypl, netanel",
  "type": "webapp",
  "category": "Utilities",
  "stability": "experimental",
  "entrypoint": "index.html",
  "minAppVersion": "0.9.97",
  "sdkVersion": "1.x",
  "permissions": [
    "fs.user_files.read",
    "fs.user_files.write",
    "reader.open",
    "reader.context_menu",
    "reader.toolbar",
    "app.startup_contributions",
    "navigation.write",
    "clipboard.read",
    "library.refresh",
    "library.books.read",
    "library.content.read",
    "app.open_url",
    "network.localhost"
  ],
  "network": {
    "enabled": true,
    "allowlist": [
      "http://127.0.0.1:47811"
    ]
  },
  "contributes": {
    "startup": {
      "contextMenuItems": [
        {
          "id": "otzaria-word-send-to-document",
          "title": "שלח למסמך",
          "icon": "document_text_24_regular",
          "contexts": ["reader-selection", "reader-page-shape-selection"],
          "openPlugin": true
        }
      ],
      "toolbarItems": [
        {
          "id": "otzaria-word-edit-book",
          "title": "ערוך בוורד לאוצריא",
          "icon": "document_edit_24_regular",
          "contexts": ["reader-text"],
          "openPlugin": true
        }
      ]
    },
    "toolTab": {
      "title": "וורד לאוצריא",
      "order": 100,
      "defaultPinned": true,
      "iconName": "document_text_24_regular"
    }
  }
}
