{
  "schemaVersion": 1,
  "id": "com.otzaria_word_editor.superdoc",
  "name": "וורד לאוצריא",
  "version": "2.2.0",
  "description": "עורך מסמכים בסגנון Word על מנוע SuperDoc, לכתיבת חידושי תורה בתוך אוצריא",
  "author": "ypl, netanel",
  "type": "webapp",
  "category": "Utilities",
  "stability": "experimental",
  "entrypoint": "index.html",
  "minAppVersion": "0.9.97",
  "sdkVersion": "1.x",
  "permissions": [
    "fs.user_files.read",
    "fs.user_files.write",
    "reader.open",
    "reader.context_menu",
    "app.startup_contributions",
    "navigation.write",
    "clipboard.read",
    "library.refresh",
    "library.books.read"
  ],
  "contributes": {
    "startup": {
      "contextMenuItems": [
        {
          "id": "otzaria-word-send-to-document",
          "title": "שלח למסמך",
          "icon": "document_text_24_regular",
          "contexts": ["reader-selection", "reader-page-shape-selection"],
          "openPlugin": true
        }
      ]
    },
    "toolTab": {
      "title": "וורד לאוצריא",
      "order": 100,
      "defaultPinned": true,
      "iconName": "document_text_24_regular"
    }
  }
}
