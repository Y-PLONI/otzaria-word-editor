Sub OpenAddinLink()
    Dim url As String
    url = "https://mitmachim.top/post/949195"
    Shell "cmd /c start """" " & url, vbHide
End Sub

Sub OpenStartupFolder()
    Dim path As String
    MsgBox "כעת תיפתח תיקייה ממנה יש למחוק את הקובץ 'שולחן העורך' וכן את הקובץ 'שולחן העורך - עיצוב פיסקה'" & vbNewLine & "יש לסגור את וורד לפני מחיקת הקובץ", vbOKOnly, "הסרת התקנה"
    path = Environ("AppData") & "\Microsoft\Word\STARTUP"
    Shell "explorer.exe " & Chr(34) & path & Chr(34), vbNormalFocus
End Sub

